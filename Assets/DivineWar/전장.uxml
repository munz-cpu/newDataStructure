<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/DivineWar/food-inventory.uss" />
    <Style src="project://database/Assets/DivineWar/interaction-hints.uss" />
    <ui:VisualElement name="draw" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; display: none;" />
    <ui:VisualElement name="death-overlay" picking-mode="Ignore" style="display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(28, 13, 18, 0.53);">
        <ui:VisualElement picking-mode="Ignore" style="position: absolute; left: 0; right: 0; top: 50%; align-items: center;">
            <ui:Label text="전사했습니다" picking-mode="Ignore" style="font-size: 42px; color: rgb(255, 196, 171); -unity-font-style: bold; text-shadow: 0 2px 3px black;" />
            <ui:Label name="respawn-countdown" picking-mode="Ignore" style="font-size: 24px; color: rgb(255, 240, 213); background-color: rgba(32, 22, 22, 0.91); padding-left: 18px; padding-right: 18px; padding-top: 3px; padding-bottom: 3px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="minimap" style="position: absolute; overflow: hidden; display: none; background-color: #271b14; background-size: 100% 100%;" />
    <ui:VisualElement name="battle-status-strip" class="battle-status-strip" picking-mode="Ignore" style="display: none;">
        <ui:VisualElement name="status-skill-1" class="battle-status-slot" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-skill-2" class="battle-status-slot" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-skill-3" class="battle-status-slot" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-skill-4" class="battle-status-slot" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-veil" class="battle-status-slot" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-guard" class="battle-status-slot battle-status-defense" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-barrier" class="battle-status-slot battle-status-defense" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-shield" class="battle-status-slot battle-status-defense" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-invulnerability" class="battle-status-slot battle-status-defense" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-undying" class="battle-status-slot battle-status-defense" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-haste" class="battle-status-slot battle-status-speed" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-empowerment" class="battle-status-slot" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-relic" class="battle-status-slot battle-status-relic" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="status-recast" class="battle-status-slot" style="display: none;">
            <ui:VisualElement class="battle-status-icon" picking-mode="Ignore" />
            <ui:Label class="battle-status-value" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="battle-skill-tooltip" class="battle-skill-tooltip" picking-mode="Ignore" style="display: none;">
        <ui:Label name="battle-skill-title" class="battle-skill-title" picking-mode="Ignore" />
        <ui:Label name="battle-skill-detail" class="battle-skill-detail" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement name="building-tooltip" class="battle-skill-tooltip" picking-mode="Ignore" style="display: none;">
        <ui:Label name="building-tooltip-title" class="battle-skill-title" picking-mode="Ignore" />
        <ui:Label name="building-tooltip-detail" class="battle-skill-detail" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement name="tutorial-mission" class="tutorial-mission" picking-mode="Ignore" style="display: none;">
        <ui:VisualElement name="tutorial-mission-icon" class="tutorial-mission-icon" picking-mode="Ignore" />
        <ui:VisualElement class="tutorial-mission-copy" picking-mode="Ignore">
            <ui:Label name="tutorial-mission-step" class="tutorial-mission-step" picking-mode="Ignore" />
            <ui:Label name="tutorial-mission-title" class="tutorial-mission-title" picking-mode="Ignore" />
            <ui:Label name="tutorial-mission-hint" class="tutorial-mission-hint" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button name="debug-show-panel" text="디버그 메뉴 열기" class="practice-debug-button practice-debug-open" style="display: none;" />
    <ui:VisualElement name="practice-debug" class="practice-debug" style="display: none;">
        <ui:VisualElement class="practice-debug-header">
            <ui:Label text="AI 연습전 디버그" class="practice-debug-title" />
            <ui:Button name="debug-hide-panel" text="숨기기" class="practice-debug-button practice-debug-hide" />
        </ui:VisualElement>
        <ui:Label name="debug-status" text="디버그 모드 켜짐" class="practice-debug-status" />
        <ui:ScrollView name="debug-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="practice-debug-scroll">
            <ui:Label text="직업" class="practice-debug-label" />
            <ui:VisualElement class="practice-debug-row">
                <ui:DropdownField name="debug-class" class="practice-debug-field" />
                <ui:Button name="debug-change-class" text="변경" class="practice-debug-button" />
            </ui:VisualElement>
            <ui:VisualElement class="practice-debug-row">
                <ui:Label text="장착 스킬" class="practice-debug-label practice-debug-skill-label" />
                <ui:DropdownField name="debug-skill-slot" class="practice-debug-slot" />
            </ui:VisualElement>
            <ui:VisualElement class="practice-debug-row practice-debug-pair">
                <ui:Button name="debug-skill-0" class="practice-debug-button practice-debug-skill" />
                <ui:Button name="debug-skill-1" class="practice-debug-button practice-debug-skill" />
            </ui:VisualElement>
            <ui:VisualElement class="practice-debug-row practice-debug-pair">
                <ui:Button name="debug-skill-2" class="practice-debug-button practice-debug-skill" />
                <ui:Button name="debug-skill-3" class="practice-debug-button practice-debug-skill" />
            </ui:VisualElement>
            <ui:VisualElement class="practice-debug-row practice-debug-pair">
                <ui:Button name="debug-skill-4" class="practice-debug-button practice-debug-skill" />
                <ui:Button name="debug-skill-5" class="practice-debug-button practice-debug-skill" />
            </ui:VisualElement>
            <ui:VisualElement class="practice-debug-row practice-debug-pair">
                <ui:Button name="debug-skill-6" class="practice-debug-button practice-debug-skill" />
                <ui:Button name="debug-skill-7" class="practice-debug-button practice-debug-skill" />
            </ui:VisualElement>
            <ui:Button name="debug-change-skill" text="선택한 스킬 장착" class="practice-debug-button" />
            <ui:Button name="debug-autoplay" text="자동 플레이 켜기" class="practice-debug-button" />
            <ui:Button name="debug-teleport" text="미니맵 순간이동" class="practice-debug-button" />
            <ui:Button name="debug-heal" text="왕 체력 완전히 회복" class="practice-debug-button" />
            <ui:Button name="debug-invulnerability" text="무적 · 꺼짐" class="practice-debug-button" />
            <ui:Button name="debug-ai-pause" text="적색 AI · 작동" class="practice-debug-button" />
            <ui:VisualElement class="practice-debug-row">
                <ui:DropdownField name="debug-resource" class="practice-debug-field" />
                <ui:Button name="debug-grant" text="+1,000" class="practice-debug-button" />
            </ui:VisualElement>
            <ui:Button name="debug-training" text="훈련 0초 · 꺼짐" class="practice-debug-button" />
            <ui:Button name="debug-cooldowns" text="모든 스킬 쿨타임 초기화" class="practice-debug-button" />
            <ui:VisualElement class="practice-debug-row practice-debug-pair">
                <ui:Button name="debug-place-dummy" text="허수아비 소환" class="practice-debug-button" />
                <ui:Button name="debug-remove-dummy" text="허수아비 제거" class="practice-debug-button" />
            </ui:VisualElement>
            <ui:Button name="debug-takeover" text="적색 AI 기지 조종" class="practice-debug-button" />
        </ui:ScrollView>
    </ui:VisualElement>
    <ui:VisualElement picking-mode="Ignore" style="position: absolute; left: 4%; right: 4%; top: 62%; align-items: center;">
        <ui:Label name="army-selection-hint" text="[Z] 주민 · [X] 병사 · [C] 브루저 · [V] 아처" picking-mode="Ignore" style="display: none; font-size: 20px; color: rgb(255, 235, 187); -unity-text-align: middle-center; white-space: normal; background-color: rgba(39, 29, 20, 0.92); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(126, 91, 53); border-right-color: rgb(126, 91, 53); border-top-color: rgb(159, 119, 74); border-bottom-color: rgb(81, 57, 34); padding-left: 20px; padding-right: 20px; padding-top: 10px; padding-bottom: 10px;" />
    </ui:VisualElement>
    <ui:VisualElement name="army-corps" class="army-corps" style="display: none;">
        <ui:Button name="corps-1" text="군단 · 0" class="filter-button" tooltip="선택한 병사를 제 1군단에 편입합니다. 1 키로 제 1군단을 선택합니다.">
            <ui:VisualElement class="corps-emblem" picking-mode="Ignore" />
        </ui:Button>
        <ui:Button name="corps-2" text="군단 · 0" class="filter-button" tooltip="선택한 병사를 제 2군단에 편입합니다. 2 키로 제 2군단을 선택합니다.">
            <ui:VisualElement class="corps-emblem" picking-mode="Ignore" />
        </ui:Button>
        <ui:Button name="corps-3" text="군단 · 0" class="filter-button" tooltip="선택한 병사를 제 3군단에 편입합니다. 3 키로 제 3군단을 선택합니다.">
            <ui:VisualElement class="corps-emblem" picking-mode="Ignore" />
        </ui:Button>
        <ui:Button name="corps-4" text="군단 · 0" class="filter-button" tooltip="선택한 병사를 제 4군단에 편입합니다. 4 키로 제 4군단을 선택합니다.">
            <ui:VisualElement class="corps-emblem" picking-mode="Ignore" />
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="army-class-filter" class="army-class-filter" style="display: none;">
        <ui:Label name="army-class-title" class="filter-title" />
        <ui:VisualElement class="filter-row">
            <ui:Button name="select-resident" text="주민 [Z]" class="filter-button" />
            <ui:Button name="select-regular" text="병사 [X]" class="filter-button" />
            <ui:Button name="select-bruiser" text="브루저 [C]" class="filter-button" />
            <ui:Button name="select-archer" text="아처 [V]" class="filter-button" />
            <ui:Button name="restore-selection" text="선택 복원" class="filter-button" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="training-cost" class="training-cost" picking-mode="Ignore" style="display: none;">
        <ui:Label name="training-cost-title" class="training-cost-title" picking-mode="Ignore" />
        <ui:Label name="training-queue" class="training-queue" picking-mode="Ignore" />
        <ui:VisualElement name="training-cost-total" class="training-cost-total" picking-mode="Ignore">
            <ui:VisualElement class="training-cost-item" picking-mode="Ignore">
                <ui:VisualElement name="training-icon-0" class="training-cost-icon" picking-mode="Ignore" />
                <ui:Label name="training-amount-0" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="training-cost-item" picking-mode="Ignore">
                <ui:VisualElement name="training-icon-1" class="training-cost-icon" picking-mode="Ignore" />
                <ui:Label name="training-amount-1" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="training-cost-item" picking-mode="Ignore">
                <ui:VisualElement name="training-icon-2" class="training-cost-icon" picking-mode="Ignore" />
                <ui:Label name="training-amount-2" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="training-cost-item" picking-mode="Ignore">
                <ui:VisualElement name="training-icon-3" class="training-cost-icon" picking-mode="Ignore" />
                <ui:Label name="training-amount-3" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="training-cost-item" picking-mode="Ignore">
                <ui:VisualElement name="training-icon-4" class="training-cost-icon" picking-mode="Ignore" />
                <ui:Label name="training-amount-4" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="training-cost-detail" class="training-cost-detail" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:Button name="food-toggle" text="인벤토리 [I]" class="food-toggle" style="display: none;" />
    <ui:VisualElement name="food-panel" class="food-panel" style="display: none;">
        <ui:Label text="고기 인벤토리" class="food-title" />
        <ui:VisualElement class="food-row">
            <ui:VisualElement name="food-icon-0" class="food-icon" picking-mode="Ignore" />
            <ui:VisualElement class="food-description" picking-mode="Ignore">
                <ui:Label text="날돼지고기" class="food-name" />
                <ui:Label name="food-recovery-0" class="food-detail" />
            </ui:VisualElement>
            <ui:Label name="food-count-0" class="food-count" text="0" />
            <ui:Button name="food-cook-0" text="굽기" class="food-small-button" />
            <ui:Button name="food-use-0" text="사용" class="food-small-button" />
        </ui:VisualElement>
        <ui:VisualElement class="food-row">
            <ui:VisualElement name="food-icon-1" class="food-icon" picking-mode="Ignore" />
            <ui:VisualElement class="food-description" picking-mode="Ignore">
                <ui:Label text="날닭고기" class="food-name" />
                <ui:Label name="food-recovery-1" class="food-detail" />
            </ui:VisualElement>
            <ui:Label name="food-count-1" class="food-count" text="0" />
            <ui:Button name="food-cook-1" text="굽기" class="food-small-button" />
            <ui:Button name="food-use-1" text="사용" class="food-small-button" />
        </ui:VisualElement>
        <ui:VisualElement class="food-row">
            <ui:VisualElement name="food-icon-2" class="food-icon" picking-mode="Ignore" />
            <ui:VisualElement class="food-description" picking-mode="Ignore">
                <ui:Label text="익힌 돼지고기" class="food-name" />
                <ui:Label name="food-recovery-2" class="food-detail" />
            </ui:VisualElement>
            <ui:Label name="food-count-2" class="food-count" text="0" />
            <ui:VisualElement class="food-cook-space" picking-mode="Ignore" />
            <ui:Button name="food-use-2" text="사용" class="food-small-button" />
        </ui:VisualElement>
        <ui:VisualElement class="food-row">
            <ui:VisualElement name="food-icon-3" class="food-icon" picking-mode="Ignore" />
            <ui:VisualElement class="food-description" picking-mode="Ignore">
                <ui:Label text="익힌 닭고기" class="food-name" />
                <ui:Label name="food-recovery-3" class="food-detail" />
            </ui:VisualElement>
            <ui:Label name="food-count-3" class="food-count" text="0" />
            <ui:VisualElement class="food-cook-space" picking-mode="Ignore" />
            <ui:Button name="food-use-3" text="사용" class="food-small-button" />
        </ui:VisualElement>
        <ui:Label name="food-status" text="완공된 아군 모닥불 근처에서 조리" class="food-detail food-status" />
    </ui:VisualElement>
</ui:UXML>
