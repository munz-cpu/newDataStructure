.army-corps {
    position: absolute;
    flex-direction: row;
    padding: 3px;
    background-color: #38281e;
    background-image: url("Art/Interface/hewn-wood-hud.png");
    background-size: 100% 100%;
}
.army-corps .filter-button {
    min-width: 89px;
    min-height: 28px;
    padding-left: 27px;
    font-size: 14px;
}
.army-corps .corps-emblem {
    position: absolute;
    left: 5px;
    top: 2px;
    bottom: 2px;
    width: 20px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.army-class-filter {
    position: absolute;
    bottom: 48px;
    left: 31%;
    right: 21%;
    background-color: rgba(39, 29, 20, 0.96);
    background-image: url("Art/Interface/hewn-wood-hud.png");
    background-size: 100% 100%;
    border-width: 2px;
    border-color: rgb(139, 102, 61);
    padding: 6px 10px;
}
.filter-title {
    font-size: 13px;
    color: rgb(242, 222, 179);
    -unity-text-align: middle-center;
}
.filter-row { flex-direction: row; justify-content: center; }
.filter-button {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(249, 233, 198);
    background-color: rgb(76, 57, 36);
    background-image: url("Art/Interface/hewn-wood-button.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: #eee1cc;
    border-width: 1px;
    border-color: rgb(143, 105, 62);
    border-radius: 0;
    padding: 5px 4px;
    margin: 3px;
}
.filter-button:hover { -unity-background-image-tint-color: white; }
.filter-button:active { -unity-background-image-tint-color: #d5b291; }
.filter-button:disabled { opacity: 0.4; }
.training-cost {
    position: absolute;
    width: 300px;
    max-width: 96%;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}
.training-cost-title { font-size: 17px; color: rgb(255, 241, 210); }
.training-queue { font-size: 14px; color: rgb(240, 230, 208); white-space: normal; }
.training-cost-total { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 3px; }
.training-cost-item { flex-direction: row; align-items: center; margin: 0 5px; font-size: 15px; }
.training-cost-icon { width: 20px; height: 20px; background-size: contain; background-repeat: no-repeat; background-position: center; }
.training-cost-detail { font-size: 13px; white-space: normal; color: rgb(255, 120, 108); }

.tutorial-mission {
    position: absolute;
    left: 18px;
    top: 16px;
    width: 314px;
    max-width: 36%;
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
    background-color: #38281e;
    background-image: url("Art/Interface/hewn-wood-hud.png");
    background-size: 100% 100%;
    border-left-width: 3px;
    border-left-color: #c6a272;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}
.tutorial-mission-icon {
    width: 42px;
    height: 42px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.tutorial-mission-copy { flex-grow: 1; min-width: 0; }
.tutorial-mission-step { margin: 0; padding: 0; font-size: 12px; color: #e4bb7e; }
.tutorial-mission-title { margin: 2px 0; padding: 0; font-size: 18px; color: #fff4dc; white-space: normal; }
.tutorial-mission-hint { margin: 0; padding: 0; font-size: 13px; color: #f0e2cc; white-space: normal; }

.practice-debug {
    position: absolute;
    left: 18px;
    top: 91px;
    bottom: 22%;
    width: 294px;
    max-width: 36%;
    max-height: 530px;
    padding: 10px 12px;
    background-color: #38281e;
    background-image: url("Art/Interface/hewn-wood-hud.png");
    background-size: 100% 100%;
    border-left-width: 3px;
    border-left-color: #c6a272;
}
.practice-debug-title { margin: 0; color: #ffebc2; font-size: 17px; -unity-font-style: bold; }
.practice-debug-header { flex-direction: row; align-items: center; justify-content: space-between; }
.practice-debug-status { margin: 3px 0 6px; min-height: 28px; color: #eccb97; font-size: 12px; white-space: normal; }
.practice-debug-scroll { flex-grow: 1; min-height: 0; }
.practice-debug-row { flex-direction: row; align-items: stretch; }
.practice-debug-label { margin: 5px 2px 1px; color: #edcca0; font-size: 12px; }
.practice-debug-field { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.practice-debug-slot { width: 68px; flex-shrink: 0; }
.practice-debug-button {
    min-height: 25px;
    margin: 2px;
    padding: 2px 5px;
    color: #fff1d7;
    font-size: 13px;
    background-color: #513b2a;
    background-image: url("Art/Interface/hewn-wood-button.png");
    background-size: 100% 100%;
    border-width: 0;
    white-space: normal;
}
.practice-debug-button:hover { -unity-background-image-tint-color: #eed6a8; color: white; }
.practice-debug-button.practice-debug-hide { margin: 0 0 0 4px; padding: 2px 9px; flex-shrink: 0; }
.practice-debug-button.practice-debug-open { position: absolute; left: 18px; top: 91px; margin: 0; padding: 4px 10px; }
.practice-debug-pair > .practice-debug-button { flex-grow: 1; flex-basis: 0; }
.practice-debug-skill-label { flex-grow: 1; }
.practice-debug .practice-debug-skill { min-width: 0; font-size: 12px; }
.practice-debug .practice-debug-skill-selected {
    -unity-background-image-tint-color: #d9a96a;
    border-width: 1px;
    border-color: #eac082;
}
.practice-debug .unity-popup-field__input {
    min-height: 25px;
    padding: 1px 4px;
    background-color: #302019;
    color: #fff1d7;
    border-color: #8a6547;
}
.practice-debug .unity-popup-field__text { overflow: hidden; text-overflow: ellipsis; }

.battle-skill-tooltip {
    position: absolute;
    width: 326px;
    max-width: 86%;
    padding: 9px 12px;
    background-color: rgba(43, 33, 26, 0.98);
    background-image: url("Art/Interface/hewn-wood-hud.png");
    background-size: 100% 100%;
    border-width: 1px;
    border-top-color: #a58758;
    border-left-color: #a58758;
    border-right-color: #58402c;
    border-bottom-color: #58402c;
}
.battle-skill-title { margin: 0 0 4px; font-size: 17px; color: #fff0cb; white-space: normal; }
.battle-skill-detail { margin: 0; font-size: 14px; color: #e4d6c3; white-space: normal; }

.battle-status-strip {
    position: absolute;
    right: 8px;
    flex-direction: row;
    flex-wrap: wrap;
}
.battle-status-slot {
    width: 36px;
    height: 36px;
    margin-right: 3px;
    margin-top: 3px;
    flex-shrink: 0;
    background-image: url("Art/Interface/hewn-wood-slot.png");
    background-size: 100% 100%;
}
.battle-status-slot:hover {
    -unity-background-image-tint-color: #ffe0ac;
}
.battle-status-icon {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    background-image: url("Art/Interface/status-power.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.battle-status-defense > .battle-status-icon { background-image: url("Art/Interface/status-defense.png"); }
.battle-status-speed > .battle-status-icon { background-image: url("Art/Interface/status-speed.png"); }
.battle-status-relic > .battle-status-icon { background-image: url("Art/Interface/status-relic.png"); }
.battle-status-value {
    position: absolute;
    bottom: 1px;
    right: 1px;
    margin: 0;
    padding: 0 2px;
    background-color: #2b211a;
    color: #fff0cb;
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-right;
}
