.unity-ui-document__root { color: #f0e7ce; font-size: 15px; }
.full { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
#draw { overflow: hidden; }
.loading { position: absolute; align-self: center; top: 46%; padding: 12px 20px; color: #f7d98b; background-color: #192b30; }
.row { flex-direction: row; align-items: center; }
.menu { justify-content: center; align-items: flex-start; padding-left: 7%; background-color: rgba(10, 15, 16, 0.32); }
.hud {
    background-color: rgba(16, 27, 29, 0.94);
    border-width: 1px;
    border-color: #566553;
    border-top-color: #b09c67;
}
.title-card {
    width: 520px;
    max-width: 94%;
    padding: 28px 32px;
    background-color: rgba(11, 19, 20, 0.92);
    border-left-width: 2px;
    border-left-color: #b89458;
}
.title { font-size: 58px; color: #f7e3b5; margin: 0; padding: 0; }
.subtitle { margin: 3px 0 22px; padding: 0; color: #bbc5b4; white-space: normal; }
.section-title { color: #e3ca8c; -unity-font-style: bold; font-size: 16px; margin-bottom: 8px; }
Button {
    color: #eae6d5;
    background-color: #253c3c;
    border-width: 1px;
    border-color: #50645d;
    border-radius: 0;
    padding: 8px 11px;
    margin: 0;
    min-height: 34px;
}
Button:hover { background-color: #3a5551; border-color: #a1caba; }
Button:active, Button.chosen { background-color: #365b54; border-color: #85cfc0; color: #f8eed3; }
.menu Button, .modal Button, Button.pause {
    background-color: transparent;
    background-image: none;
    border-width: 0;
    border-bottom-width: 1px;
    border-color: transparent;
    color: #e9e5d7;
    min-height: 35px;
    padding: 4px 0;
    -unity-text-align: middle-left;
    transition-property: color;
    transition-duration: 100ms;
    transition-timing-function: ease-out;
}
.menu Button.primary, .modal Button.primary { font-size: 25px; color: #f3dfb3; }
.menu Button.chosen, .modal Button.chosen { color: #9bd9c6; }
.menu Button:focus, .modal Button:focus, Button.pause:focus { border-bottom-color: #8b9a89; }
.menu Button:hover, .modal Button:hover, Button.pause:hover,
.menu Button.primary:hover, .modal Button.primary:hover { color: #ffd176; }
.menu Button:disabled, .menu Button.primary:disabled, .modal Button:disabled { color: #858f88; }
.menu .section-title, .modal .section-title { margin: 0 0 3px; padding: 0; }
.classes { flex-wrap: wrap; }
.classes > Button, .movement-options > Button { margin-right: 22px; }
.classes > Button:last-child, .movement-options > Button:last-child { margin-right: 0; }
.class-info { margin: 1px 0 13px; padding: 0; color: #a5c2b4; white-space: normal; min-height: 21px; }
#solo { min-height: 43px; align-self: flex-start; }
.rule { height: 1px; background-color: #42534e; margin: 15px 0; }
.title-card TextField { margin: 0 0 5px; min-height: 33px; }
TextField > Label { min-width: 92px; color: #cdc7b1; }
.unity-text-field__input { background-color: #101e22; color: #f0e7ce; border-color: #53635a; border-radius: 0; padding-left: 8px; }
.code-row { align-items: flex-start; }
#code { flex-grow: 1; }
#copy { min-height: 32px; margin-left: 10px; }
.room-status { margin: 0 0 3px; padding: 0; color: #f1d392; white-space: normal; }
.network-note { font-size: 13px; color: #a5b3a5; margin: 4px 0 0; padding: 0; white-space: normal; }
.top { position: absolute; top: 11px; left: 13px; padding: 7px 11px; min-width: 495px; }
.top-row { justify-content: space-between; }
.resources { -unity-font-style: bold; color: #f4d291; }
.population { color: #bdd0bd; margin-left: 19px; font-size: 13px; }
.scores { justify-content: space-between; margin-top: 2px; }
.own { color: #8adfd2; }
.enemy { color: #ffaa8b; }
.clock { color: #efe3bc; -unity-font-style: bold; }
.pause { position: absolute; top: 11px; right: 15px; -unity-text-outline-width: 1px; -unity-text-outline-color: #101818; }
.briefing { margin-top: 5px; padding-top: 5px; border-top-width: 1px; border-top-color: #48594f; font-size: 13px; }
#notice { color: #e9c779; margin: 0; }
.controls { position: absolute; bottom: 11px; left: 13px; right: 235px; padding: 8px 10px 6px; max-width: 730px; }
.controls-title { justify-content: space-between; margin-bottom: 4px; }
#king-status { -unity-font-style: bold; color: #f1d392; }
#center { min-height: 23px; padding: 2px 8px; font-size: 12px; }
.slots { margin-bottom: 5px; align-items: stretch; }
.slots > Button { flex: 1 1 0; margin-right: 5px; white-space: normal; font-size: 13px; padding: 4px 4px; }
.slots > Button:last-child { margin-right: 0; }
.skill-bar { align-items: stretch; margin-bottom: 7px; }
.skill {
    flex: 1 1 0;
    min-width: 0;
    height: 70px;
    margin-right: 5px;
    padding-top: 3px;
    align-items: center;
    justify-content: center;
    background-color: #152428;
    border-width: 1px;
    border-bottom-width: 2px;
    border-color: #354746;
}
.skill:last-child { margin-right: 0; }
.skill.ready { background-color: #1d3032; border-color: #516763; }
.skill-q.ready { border-bottom-color: #d79c58; }
.skill-w.ready { border-bottom-color: #6db9ae; }
.skill-e.ready { border-bottom-color: #9dbf76; }
.skill-r.ready { border-bottom-color: #b88ec3; }
.skill-key, .skill-time {
    position: absolute;
    top: 5px;
    margin: 0;
    height: 18px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.skill-key {
    left: 5px;
    width: 20px;
    color: #aab6af;
    background-color: #101d21;
    border-width: 1px;
    border-color: #40534f;
}
.skill.ready > .skill-key { color: #f3e9cf; border-color: #65756a; }
.skill-time {
    display: none;
    right: 5px;
    padding: 0 4px;
    color: #ffe2a4;
    background-color: #111d20;
}
.skill-icon { width: 42px; height: 42px; opacity: 0.45; }
.skill.ready > .skill-icon { opacity: 1; }
.skill-name { margin: 1px 0 0; color: #a5b6b0; font-size: 14px; -unity-text-align: middle-center; }
.skill.ready > .skill-name { color: #f1e7cf; }
#help { color: #bbc8b6; font-size: 12px; white-space: normal; margin: 0; }
.right-hud { position: absolute; bottom: 11px; right: 13px; width: 208px; }
.build-panel { display: none; margin-bottom: 6px; padding: 8px; }
.build-panel > .section-title { margin: 0 0 6px; }
.build-option { flex-direction: row; align-items: center; justify-content: flex-start; padding: 5px 8px; margin-bottom: 4px; }
.build-option:last-child { margin-bottom: 0; }
.build-preview { width: 36px; height: 36px; margin-right: 8px; background-size: contain; }
.build-name, .build-cost { margin: 0; }
.build-name { -unity-font-style: bold; }
.build-cost { color: #c9c7ac; font-size: 12px; }
.build-toggle { align-items: center; justify-content: center; align-self: flex-end; width: 42px; height: 36px; margin-top: 6px; padding: 0; border-color: #b09c67; }
.hammer-icon { width: 24px; height: 24px; }
#build-cursor { position: absolute; top: 0; left: 0; display: none; }
.map { padding: 6px; }
.map > Label { color: #e1d0a2; font-size: 12px; margin: 0 0 4px; }
#minimap { height: 112px; background-color: #344e44; overflow: hidden; }
.modal { justify-content: center; align-items: center; background-color: rgba(8, 13, 14, 0.76); }
.modal-card {
    width: 415px;
    max-width: 94%;
    padding: 24px 30px;
    background-color: rgba(12, 20, 21, 0.94);
    border-top-width: 2px;
    border-top-color: #b89458;
}
#modal-title { font-size: 47px; color: #f7e3b5; margin: 0; padding: 0; }
#modal-copy { white-space: normal; color: #bbc5b4; margin: 4px 0 17px; padding: 0; }
.movement-options { flex-wrap: wrap; }
#movement-settings { margin-bottom: 9px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: #42534e; }
.modal-card > Button { align-self: flex-start; }

