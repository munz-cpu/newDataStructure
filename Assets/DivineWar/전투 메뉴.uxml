<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="full modal">
        <ui:VisualElement class="modal-card">
            <ui:Label name="modal-title" />
            <ui:Label name="modal-copy" />
            <ui:VisualElement name="movement-settings">
                <ui:Label text="왕 이동 방식" class="section-title" />
                <ui:VisualElement class="row movement-options">
                    <ui:Button name="move-click" text="마우스 우클릭" />
                    <ui:Button name="move-wasd" text="WASD" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="resume" text="계속하기" class="primary" />
            <ui:Button name="leave" text="타이틀로 돌아가기" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

